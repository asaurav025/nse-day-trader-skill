# /etc/kite-mcp/kite.env: environment for kite-mcp.service (root:root, mode 0600).
# bootstrap.sh writes this file once from deploy/kite.env.example and never overwrites it.
# Fill KITE_API_KEY and KITE_API_SECRET by hand on the VPS (sudoedit /etc/kite-mcp/kite.env).
# Never paste them into chat, a ticket, or a tracked file.
# Variable names are the ones kite-mcp-server v0.3.2 reads (app/app.go).

KITE_API_KEY=
KITE_API_SECRET=

# Streamable HTTP: the MCP endpoint is /mcp (sse mode would serve /sse and /message instead).
APP_MODE=http
# Loopback only. kite-mcp.service also forces APP_HOST=127.0.0.1, whatever this says.
APP_HOST=127.0.0.1
APP_PORT=__MCP_PORT__
# Base of the login links the `login` tool hands out (<base>/authorize?...). Must be the
# public hostname, or the link points at the VPS's own loopback.
PUBLIC_BASE_URL=https://__KITE_HOSTNAME__

# Tools the skill never uses, hidden from Claude: GTT is out of scope, and a stop is never
# modified (flatten = cancel the SL-M, then a MARKET sell).
EXCLUDED_TOOLS=place_gtt_order,modify_gtt_order,delete_gtt_order,modify_order

LOG_LEVEL=info

# Leave ADMIN_ENDPOINT_SECRET_PATH unset: when set, the server serves /admin/ on the same
# listener, which the tunnel would expose.
