# deploy/.env.deploy: settings for bootstrap.sh. Copy to deploy/.env.deploy (gitignored),
# fill it in on your laptop, copy the deploy/ folder to the VPS, run bootstrap.sh as root.
# The Kite API key and secret are NOT here: they go in /etc/kite-mcp/kite.env on the VPS, by hand.

# Login user created on the VPS (sudo, SSH key only).
ADMIN_USER=trader
# One public key line, in quotes.
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAA...replace-me... you@laptop"

# SSH reachability. Either give the one IPv4 address you SSH from (ufw allows port 22
# from it only), or leave it empty AND set SSH_VIA_TUNNEL_ONLY=yes, meaning port 22 is
# closed to the internet and you reach SSH through the Cloudflare Tunnel (see README.md).
ADMIN_SSH_FROM_IP=
SSH_VIA_TUNNEL_ONLY=no

# Public hostname of the MCP server on your Cloudflare zone (Access protects it).
KITE_HOSTNAME=kite.example.in
# Token of the remotely-managed tunnel (Zero Trust > Networks > Tunnels > your tunnel).
CF_TUNNEL_TOKEN=
# Loopback port kite-mcp-server listens on (127.0.0.1 only).
MCP_PORT=8080

# The Vultr Reserved IP you whitelist with Zerodha. The daily egress check compares the
# VPS's outbound IPv4 address with it.
EXPECTED_STATIC_IP=203.0.113.10
# api.kite.trade has an IPv6 address; on a dual-stack VPS the server may reach Kite over
# IPv6, which would not match the whitelisted IPv4. yes = turn IPv6 off (recommended).
DISABLE_IPV6=yes

# kite-mcp-server release. The SHA-256 below is the v0.3.2 linux-amd64 asset (it matches
# GitHub's published digest). Change both together, never one alone.
KITE_MCP_VERSION=v0.3.2
KITE_MCP_SHA256=12c5c0689ce87a1e577879818beb23df8ba791026cd2981ce88a484621ef5483
# Source fallback (non-x86_64 VPS): the commit the tag must point at.
KITE_MCP_COMMIT=5e044dc11c0846794af1a3f1e74bf50701cf44e3

TIMEZONE=Asia/Kolkata
